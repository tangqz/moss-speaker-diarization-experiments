#!/usr/bin/env bash

# Full-attention SFT baseline. Run only after the smoke job succeeds.
# Before submitting, replace every <netid> and review MAX_LENGTH, epochs,
# checkpoint frequency, and the official dataset split.

#SBATCH --job-name=moss-full-attn
#SBATCH --partition=common-gpu
#SBATCH --gres=gpu:1
#SBATCH --exclusive
#SBATCH --time=7-00:00:00
#SBATCH --output=/work/<netid>/moss/logs/%x-%j.out
#SBATCH --error=/work/<netid>/moss/logs/%x-%j.err

set -euo pipefail

MOSS_ROOT="/work/<netid>/moss/MOSS-Transcribe-Diarize"
TRAIN_JSONL="/work/<netid>/moss/data/train.jsonl"
OUTPUT_DIR="/work/<netid>/moss/checkpoints/full-attention-baseline-${SLURM_JOB_ID}"
MODEL_NAME_OR_PATH="OpenMOSS-Team/MOSS-Transcribe-Diarize"
MAX_LENGTH="32768"

cd "$MOSS_ROOT"
source .venv/bin/activate
export TOKENIZERS_PARALLELISM=false

echo "job=${SLURM_JOB_ID} host=$(hostname)"
nvidia-smi

python finetune.py \
  --train_jsonl "$TRAIN_JSONL" \
  --model_name_or_path "$MODEL_NAME_OR_PATH" \
  --output_dir "$OUTPUT_DIR" \
  --per_device_train_batch_size 1 \
  --num_train_epochs 3 \
  --learning_rate 1e-5 \
  --max_length "$MAX_LENGTH" \
  --bf16 \
  --gradient_checkpointing \
  --logging_steps 10 \
  --save_strategy steps \
  --save_steps 500 \
  --save_total_limit 2 \
  --report_to none \
  --dataloader_num_workers 0
